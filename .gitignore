# ========================================
# Kanban Time Tracker - .gitignore
# ========================================

# ========================================
# Node.js
# ========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ========================================
# Environment Variables
# ========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Sauf les fichiers d'exemple
!.env.example
!frontend/.env.example
!backend/.env.example

# ========================================
# Build & Distribution
# ========================================
dist/
build/
*.tsbuildinfo
.cache/

# Frontend
frontend/dist/
frontend/build/
frontend/.vite/

# Backend
backend/dist/
backend/build/

# ========================================
# Logs
# ========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ========================================
# IDE & Editors
# ========================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Cursor
.cursor/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# ========================================
# OS Files
# ========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ========================================
# Testing
# ========================================
coverage/
*.lcov
.nyc_output/
.coverage
.coverage.*
htmlcov/
junit.xml
test-results/
.cache/

# ========================================
# Temporary Files
# ========================================
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ========================================
# Database
# ========================================
*.sqlite
*.sqlite3
*.db
postgres_data/
pgdata/

# Sequelize CLI
.sequelizerc.local

# ========================================
# Docker
# ========================================
docker-compose.override.yml
.docker/

# ========================================
# TypeScript
# ========================================
*.tsbuildinfo
.tsbuildinfo

# ========================================
# Package Managers
# ========================================
package-lock.json.lock
yarn.lock.frozen
.yarn/
.pnp.*
.pnp.js

# ========================================
# Runtime Data
# ========================================
pids/
*.pid
*.seed
*.pid.lock

# ========================================
# Optional npm cache directory
# ========================================
.npm/

# ========================================
# Optional eslint cache
# ========================================
.eslintcache

# ========================================
# Optional stylelint cache
# ========================================
.stylelintcache

# ========================================
# Microbundle cache
# ========================================
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# ========================================
# Optional REPL history
# ========================================
.node_repl_history

# ========================================
# Output of 'npm pack'
# ========================================
*.tgz

# ========================================
# Serverless
# ========================================
.serverless/
.webpack/

# ========================================
# FuseBox cache
# ========================================
.fusebox/

# ========================================
# DynamoDB Local files
# ========================================
.dynamodb/

# ========================================
# TernJS port file
# ========================================
.tern-port

# ========================================
# Stores VSCode versions used for testing
# ========================================
.vscode-test

# ========================================
# Yarn Integrity file
# ========================================
.yarn-integrity

# ========================================
# parcel-bundler cache
# ========================================
.parcel-cache/

# ========================================
# Next.js
# ========================================
.next/
out/

# ========================================
# Nuxt.js
# ========================================
.nuxt/
dist/

# ========================================
# Gatsby
# ========================================
.cache/
public/

# ========================================
# Vuepress
# ========================================
.vuepress/dist

# ========================================
# Docusaurus
# ========================================
.docusaurus

# ========================================
# SvelteKit
# ========================================
.svelte-kit

# ========================================
# Project Specific
# ========================================
# Documentation temporaire
*.draft.md
*.wip.md

# Fichiers de migration personnels
migrations/*.draft.*

# Exports CSV temporaires
exports/*.csv
temp_exports/

# Fichiers de backup
backup/
*.backup

# Fichiers de configuration locale
config.local.*

# ========================================
# Security
# ========================================
# Clés privées
*.pem
*.key
*.cert
*.crt
secrets/
.secrets/

# Tokens
.token
.tokens

# ========================================
# Misc
# ========================================
*.orig
.vercel
.turbo
.contentlayer
.netlify
