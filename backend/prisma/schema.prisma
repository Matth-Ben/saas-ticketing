generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id           String       @id
  name         String
  type         DocumentType
  filePath     String
  fileSize     Int
  mimeType     String
  projectId    String
  uploadedById String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  Project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Invoice {
  id              String        @id
  type            InvoiceType
  number          String        @unique
  projectId       String
  amount          Float
  taxRate         Float         @default(0)
  totalAmount     Float
  status          InvoiceStatus @default(draft)
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  paidAt          DateTime?
  signedAt        DateTime?
  signatureData   Json?
  clientLinkToken String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  Project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  InvoiceItem     InvoiceItem[]

  @@index([clientLinkToken])
  @@index([projectId])
  @@index([status])
}

model InvoiceItem {
  id          String   @id
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Float
  total       Float
  createdAt   DateTime @default(now())
  Invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Organization {
  id                   String                @id
  name                 String
  type                 OrganizationType      @default(agency)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  OrganizationSettings OrganizationSettings?
  Project              Project[]
  User                 User[]

  @@index([name])
}

model OrganizationSettings {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  logo                  String?
  primaryColor          String?
  require2FA            Boolean      @default(false)
  requireStrongPassword Boolean      @default(true)
  enableTimeline        Boolean      @default(true)
  enableAnalytics       Boolean      @default(false)
  enableDrive           Boolean      @default(true)
  enableIntegrations    Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  Organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Project {
  id             String          @id
  name           String
  description    String?
  status         ProjectStatus   @default(active)
  organizationId String?
  creatorId      String
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  Document       Document[]
  Invoice        Invoice[]
  User           User            @relation(fields: [creatorId], references: [id])
  Organization   Organization?   @relation(fields: [organizationId], references: [id])
  ProjectMember  ProjectMember[]
  Ticket         Ticket[]

  @@index([creatorId])
  @@index([organizationId])
}

model ProjectMember {
  id        String            @id
  projectId String
  userId    String
  role      ProjectMemberRole @default(member)
  createdAt DateTime          @default(now())
  Project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  User      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Subscription {
  id                   String             @id
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 SubscriptionPlan   @default(perso)
  status               SubscriptionStatus @default(trial)
  billingPeriod        BillingPeriod      @default(month)
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime
  User                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([userId])
}

model SupportComment {
  id            String        @id
  ticketId      String
  message       String
  userId        String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  SupportTicket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model SupportTicket {
  id             String              @id
  subject        String
  message        String
  status         SupportTicketStatus @default(open)
  priority       TicketPriority      @default(medium)
  userId         String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime
  SupportComment SupportComment[]
  User           User                @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
}

model Ticket {
  id                  String                @id
  title               String
  description         String?
  status              TicketStatus          @default(todo)
  priority            TicketPriority        @default(medium)
  projectId           String
  creatorId           String
  estimatedTime       Int?
  spentTime           Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  User                User                  @relation(fields: [creatorId], references: [id])
  Project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  TicketAssignee      TicketAssignee[]
  TimeTrackingSession TimeTrackingSession[]

  @@index([creatorId])
  @@index([projectId])
  @@index([status])
}

model TicketAssignee {
  id        String   @id
  ticketId  String
  userId    String
  createdAt DateTime @default(now())
  Ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([ticketId])
  @@index([userId])
}

model TimeTrackingSession {
  id        String    @id
  ticketId  String
  userId    String
  startTime DateTime  @default(now())
  endTime   DateTime?
  duration  Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime
  Ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
}

model User {
  id                   String           @id
  email                String           @unique
  password             String?
  role                 UserRole         @default(freelance)
  organizationId       String?
  firstName            String?
  lastName             String?
  avatar               String?
  googleId             String?          @unique
  emailVerified        Boolean          @default(false)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  lastLogin            DateTime?
  sessionCount         Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime
  phoneNumber          String?
  twoFactorEnabled     Boolean          @default(false)
  twoFactorSecret      String?
  Project              Project[]
  ProjectMember        ProjectMember[]
  Subscription         Subscription?
  SupportTicket        SupportTicket[]
  Ticket               Ticket[]
  TicketAssignee       TicketAssignee[]
  Organization         Organization?    @relation(fields: [organizationId], references: [id])
  UserAnalytics        UserAnalytics?
  UserSession          UserSession[]
  UserSettings         UserSettings?

  @@index([email])
  @@index([organizationId])
}

model UserAnalytics {
  id              String    @id
  userId          String    @unique
  loginCount      Int       @default(0)
  lastLogin       DateTime?
  sessionDuration Int       @default(0)
  featuresUsed    Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  User            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  device       String?
  browser      String?
  ipAddress    String?
  userAgent    String?
  loginAt      DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  logoutAt     DateTime?
  token        String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  User         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model UserSettings {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  language                 String   @default("fr")
  timezone                 String   @default("Europe/Paris")
  theme                    String   @default("system")
  enableQuotes             Boolean  @default(true)
  enableTimeline           Boolean  @default(false)
  enableDrive              Boolean  @default(true)
  enableClientLink         Boolean  @default(true)
  enableAnalytics          Boolean  @default(false)
  enableTimeTracking       Boolean  @default(true)
  notificationsEmail       Boolean  @default(true)
  notificationsInApp       Boolean  @default(true)
  notificationsPush        Boolean  @default(false)
  notifyOnTicketAssignment Boolean  @default(true)
  notifyOnComment          Boolean  @default(true)
  notifyOnStatusChange     Boolean  @default(true)
  notifyOnInvoice          Boolean  @default(true)
  notifyOnPaymentFailed    Boolean  @default(true)
  weeklyDigest             Boolean  @default(false)
  billingDisplayMode       String   @default("HT")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  User                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum BillingPeriod {
  month
  year
}

enum DocumentType {
  file
  image
  pdf
  other
}

enum InvoiceStatus {
  draft
  sent
  signed
  paid
  cancelled
}

enum InvoiceType {
  invoice
  quote
  contract
}

enum OrganizationType {
  freelance
  agency
  enterprise
}

enum ProjectMemberRole {
  owner
  member
  viewer
}

enum ProjectStatus {
  active
  archived
  completed
}

enum SubscriptionPlan {
  perso
  agence
  entreprise
}

enum SubscriptionStatus {
  trial
  active
  cancelled
  expired
  past_due
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
}

enum TicketStatus {
  todo
  in_progress
  done
  cancelled
}

enum UserRole {
  freelance
  agency
  enterprise
  admin
}
